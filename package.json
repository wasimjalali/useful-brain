{
  "name": "useful-brain",
  "version": "0.1.0",
  "private": true,
  "description": "A company knowledge and action agent with source-grounded answers, visible evidence and controlled tool use.",
  "license": "MIT",
  "author": "Wasim Jalali",
  "repository": {
    "type": "git",
    "url": "https://github.com/wasimjalali/useful-brain.git"
  },
  "homepage": "https://github.com/wasimjalali/useful-brain#readme",
  "keywords": [
    "rag",
    "retrieval-augmented-generation",
    "nextjs",
    "cloudflare",
    "vector-search",
    "embeddings",
    "llm",
    "citations"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --config vitest.config.ts && npm run test:workers",
    "test:workers": "npm run types:workers && vitest run --config workers/brain/vitest.config.mts && vitest run --config workers/ingestion/vitest.config.mts",
    "types:workers": "wrangler types workers/brain/worker-configuration.d.ts -c workers/brain/wrangler.jsonc && wrangler types workers/ingestion/worker-configuration.d.ts -c workers/ingestion/wrangler.jsonc",
    "typecheck:workers": "npm run types:workers && tsc --noEmit -p workers/brain/tsconfig.json && tsc --noEmit -p workers/ingestion/tsconfig.json",
    "test:watch": "vitest",
    "install:spike:pi": "npm --prefix spikes/phase-0-pi-worker ci --legacy-peer-deps",
    "typecheck:spike:pi": "npm --prefix spikes/phase-0-pi-worker run typecheck",
    "test:spike:pi": "npm --prefix spikes/phase-0-pi-worker test",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opennextjs/cloudflare": "1.20.3",
    "convex": "^1.42.1",
    "next": "16.3.3",
    "rclone.js": "0.6.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typebox": "1.3.7",
    "unpdf": "^1.6.2"
  },
  "overrides": {
    "postcss": "8.5.26",
    "nanoid": "3.3.18",
    "adm-zip": "0.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "4.126.0"
  }
}
