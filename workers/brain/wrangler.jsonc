{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "useful-brain-brain",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "ip": "127.0.0.1"
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "RUNTIME_ENV": "development",
    "IDENTITY_MODE": "loopback",
    "RESOURCES_PROVISIONED": "false",
    "WRANGLER_ACCESS_DEV": "false",
    "LOOPBACK_RUNTIME": "true",
    "LOOPBACK_SUBJECT": "dev@localhost"
  },
  "d1_databases": [
    {
      "binding": "CORPUS_DB",
      "database_name": "useful-brain-corpus-development",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "../../migrations/corpus"
    },
    {
      "binding": "OPERATIONS_DB",
      "database_name": "useful-brain-operations-development",
      "database_id": "00000000-0000-4000-8000-000000000002",
      "migrations_dir": "../../migrations/operations"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "queues": {
    "producers": [
      {
        "binding": "INGEST_QUEUE",
        "queue": "useful-brain-ingest-development"
      },
      {
        "binding": "APPROVAL_RESUME_QUEUE",
        "queue": "useful-brain-approval-resume-development"
      }
    ],
    "consumers": [
      {
        "queue": "useful-brain-approval-resume-development",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "useful-brain-approval-resume-dlq-development"
      },
      {
        "queue": "useful-brain-approval-resume-dlq-development",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERSATION",
        "class_name": "ConversationRunLock"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ConversationRunLock"]
    }
  ],
  "workflows": [
    {
      "name": "useful-brain-approval",
      "binding": "APPROVAL_WORKFLOW",
      "class_name": "ApprovalWorkflow"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "env": {
    "development": {
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "RUNTIME_ENV": "development",
        "IDENTITY_MODE": "loopback",
        "RESOURCES_PROVISIONED": "false",
        "WRANGLER_ACCESS_DEV": "false",
        "LOOPBACK_RUNTIME": "true",
        "LOOPBACK_SUBJECT": "dev@localhost"
      },
      "d1_databases": [
        {
          "binding": "CORPUS_DB",
          "database_name": "useful-brain-corpus-development",
          "database_id": "00000000-0000-4000-8000-000000000001",
          "migrations_dir": "../../migrations/corpus"
        },
        {
          "binding": "OPERATIONS_DB",
          "database_name": "useful-brain-operations-development",
          "database_id": "00000000-0000-4000-8000-000000000002",
          "migrations_dir": "../../migrations/operations"
        }
      ],
      "ai": { "binding": "AI", "remote": true },
      "queues": {
        "producers": [
          { "binding": "INGEST_QUEUE", "queue": "useful-brain-ingest-development" },
          {
            "binding": "APPROVAL_RESUME_QUEUE",
            "queue": "useful-brain-approval-resume-development"
          }
        ],
        "consumers": [
          {
            "queue": "useful-brain-approval-resume-development",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "useful-brain-approval-resume-dlq-development"
          },
          {
            "queue": "useful-brain-approval-resume-dlq-development",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3
          }
        ]
      },
      "durable_objects": {
        "bindings": [{ "name": "CONVERSATION", "class_name": "ConversationRunLock" }]
      },
      "workflows": [
        {
          "name": "useful-brain-approval-development",
          "binding": "APPROVAL_WORKFLOW",
          "class_name": "ApprovalWorkflow"
        }
      ],
      "triggers": {
        "crons": ["*/5 * * * *"]
      }
    },
    "staging": {
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1
      },
      "vars": {
        "RUNTIME_ENV": "staging",
        "IDENTITY_MODE": "disabled",
        "RESOURCES_PROVISIONED": "true",
        "WRANGLER_ACCESS_DEV": "false",
        "LOOPBACK_RUNTIME": "false",
        "LOOPBACK_SUBJECT": ""
      },
      "d1_databases": [
        {
          "binding": "CORPUS_DB",
          "database_name": "useful-brain-corpus-staging",
          "database_id": "d9c08e55-e2fa-4489-a9ee-50fdf818d62c",
          "migrations_dir": "../../migrations/corpus"
        },
        {
          "binding": "OPERATIONS_DB",
          "database_name": "useful-brain-operations-staging",
          "database_id": "c2f5b3bc-3924-4e7e-be25-b1aa2020ac3e",
          "migrations_dir": "../../migrations/operations"
        }
      ],
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "useful-brain-staging" }],
      "ai": { "binding": "AI" },
      "queues": {
        "producers": [
          { "binding": "INGEST_QUEUE", "queue": "useful-brain-ingest-staging" },
          {
            "binding": "APPROVAL_RESUME_QUEUE",
            "queue": "useful-brain-approval-resume-staging"
          }
        ],
        "consumers": [
          {
            "queue": "useful-brain-approval-resume-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "useful-brain-approval-resume-dlq-staging"
          },
          {
            "queue": "useful-brain-approval-resume-dlq-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3
          }
        ]
      },
      "durable_objects": {
        "bindings": [{ "name": "CONVERSATION", "class_name": "ConversationRunLock" }]
      },
      "workflows": [
        {
          "name": "useful-brain-approval-staging",
          "binding": "APPROVAL_WORKFLOW",
          "class_name": "ApprovalWorkflow"
        }
      ],
      "triggers": {
        "crons": ["*/5 * * * *"]
      }
    },
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "RUNTIME_ENV": "production",
        "IDENTITY_MODE": "access",
        "RESOURCES_PROVISIONED": "false",
        "WRANGLER_ACCESS_DEV": "false",
        "LOOPBACK_RUNTIME": "false",
        "LOOPBACK_SUBJECT": ""
      },
      "d1_databases": [
        {
          "binding": "CORPUS_DB",
          "database_name": "useful-brain-corpus-production",
          "database_id": "00000000-0000-4000-8000-000000000021",
          "migrations_dir": "../../migrations/corpus"
        },
        {
          "binding": "OPERATIONS_DB",
          "database_name": "useful-brain-operations-production",
          "database_id": "00000000-0000-4000-8000-000000000022",
          "migrations_dir": "../../migrations/operations"
        }
      ],
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "useful-brain-production" }],
      "ai": { "binding": "AI" },
      "queues": {
        "producers": [
          { "binding": "INGEST_QUEUE", "queue": "useful-brain-ingest-production" },
          {
            "binding": "APPROVAL_RESUME_QUEUE",
            "queue": "useful-brain-approval-resume-production"
          }
        ],
        "consumers": [
          {
            "queue": "useful-brain-approval-resume-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "useful-brain-approval-resume-dlq-production"
          },
          {
            "queue": "useful-brain-approval-resume-dlq-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3
          }
        ]
      },
      "durable_objects": {
        "bindings": [{ "name": "CONVERSATION", "class_name": "ConversationRunLock" }]
      },
      "workflows": [
        {
          "name": "useful-brain-approval-production",
          "binding": "APPROVAL_WORKFLOW",
          "class_name": "ApprovalWorkflow"
        }
      ],
      "triggers": {
        "crons": []
      }
    }
  }
}
