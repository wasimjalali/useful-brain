{
  "name": "useful-brain-ingestion",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "RUNTIME_ENV": "development",
    "IDENTITY_MODE": "loopback",
    "RESOURCES_PROVISIONED": "false",
    "WRANGLER_ACCESS_DEV": "false",
    "LOOPBACK_RUNTIME": "true"
  },
  "d1_databases": [
    {
      "binding": "CORPUS_DB",
      "database_name": "useful-brain-corpus-test",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "../../migrations/corpus"
    }
  ],
  "workflows": [
    {
      "name": "useful-brain-ingestion-test",
      "binding": "INGESTION_WORKFLOW",
      "class_name": "IngestionWorkflow"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "useful-brain-ingest-development",
        "max_retries": 5,
        "dead_letter_queue": "useful-brain-ingest-dlq-development"
      }
    ]
  }
}
