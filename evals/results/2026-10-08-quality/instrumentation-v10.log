DBG-QUALITY raw {"q":"A customer asks to speak to someone about how their case was handled. How quickly must we acknowledge it, and when does it move up to the next escalation level?","searches":[{"query":"customer complaint acknowledgment timeframe how their case was handled"},{"query":"complaint escalation level timing move to next escalation level"}],"rawFinal":"The agent logs the complaint in the support system with an ESC-#### code, attaches the ticket history, and responds to the customer within four business hours with an acknowledgment and a named owner. [1]\n\nIf the complaint is not resolved within two business days of the ESC-1 acknowledgment, it escalates to ESC-2 and the support manager takes over. [3]","grounded":"The agent logs the complaint in the support system with an ESC-#### code, attaches the ticket history, and responds to the customer within four business hours with an acknowledgment and a named owner. [1]\n\nIf the complaint is not resolved within two business days of the ESC-1 acknowledgment, it escalates to ESC-2 and the support manager takes over. [3]","ev":[["[1]","nw_support_complaint_escalation","ESC-1: Complaint Logged"],["[2]","nw_support_sla_policy","Relationship to Other Policies"],["[3]","nw_support_complaint_escalation","ESC-2: Support Manager Review"],["[4]","nw_support_dsar_process","Escalation and Disputes"],["[5]","nw_support_complaint_escalation","Complaint Records"],["[6]","nw_support_complaint_escalation","ESC-3: VP Support"],["[7]","nw_support_complaint_escalation","ESC-4: Executive Complaints"],["[8]","nw_support_complaint_escalation","Relationship to Other Policies"],["[9]","nw_support_complaint_escalation","Overview"],["[10]","nw_finance_invoicing_payment","Billing Disputes"],["[11]","nw_support_ticket_priority","Communication Standards"],["[12]","nw_engineering_incident_escalation","Overview"]]}
